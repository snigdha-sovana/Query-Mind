# LLM API Keys
GEMINI_API_KEY="your_gemini_api_key"
QUERYMIND_LLM_PROVIDER="gemini"
QUERYMIND_LLM_MODEL="gemini-3.8-flash"

# Data Directories (Absolute or relative paths)
QUERYMIND_DATA_DIR="./data/bird_mini_dev"

# Safety limits
QUERYMIND_ROW_LIMIT=500
QUERYMIND_QUERY_TIMEOUT_S=10
QUERYMIND_MAX_SQL_RETRIES=3
QUERYMIND_MAX_ITERS=3
QUERYMIND_SCHEMA_TOP_K=6
